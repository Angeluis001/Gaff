# GAFF All Fishing — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# === DATABASE (Phase 1) ===
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === UPSTASH REDIS (Phase 1) ===
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# === SENTRY (Phase 1) ===
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
SENTRY_AUTH_TOKEN=xxx
SENTRY_ORG=xxx
SENTRY_PROJECT=xxx

# === STRIPE (Phase 3) ===
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# === RESEND (Phase 3) ===
RESEND_API_KEY=re_xxx

# === NEXTAUTH (Phase 4) ===
NEXTAUTH_SECRET=xxx
NEXTAUTH_URL=https://gaffallfishingloscabos.com
ADMIN_BOOTSTRAP_EMAIL=admin@gaffallfishingloscabos.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
ADMIN_BOOTSTRAP_NAME=GAFF Admin
ADMIN_BOOTSTRAP_ROLE=admin

# === CLOUDINARY (Phase 2) ===
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
NEXT_PUBLIC_CLOUDINARY_HERO_VIDEO_ID=gaff/landing/hero-marlin-run
NEXT_PUBLIC_CLOUDINARY_HERO_POSTER_ID=gaff/landing/hero-marlin-poster

# === OPENAI (Phase 5) ===
OPENAI_API_KEY=sk-xxx
OPENAI_LEAD_MODEL=gpt-4o-mini
OPENAI_REVIEW_MODEL=gpt-4o

# === META / FACEBOOK (Phase 7) ===
META_APP_ID=xxx
META_APP_SECRET=xxx
META_PAGE_ACCESS_TOKEN=xxx
META_PAGE_ID=xxx
META_GRAPH_API_VERSION=v19.0

# === GOOGLE ANALYTICS (Phase 2) ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-xxx
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-xxx
NEXT_PUBLIC_META_PIXEL_ID=xxx
NEXT_PUBLIC_TIKTOK_PIXEL_ID=xxx

# === BOTPRESS (Phase 2/5) ===
NEXT_PUBLIC_BOTPRESS_BOT_ID=xxx
NEXT_PUBLIC_BOTPRESS_CLIENT_ID=xxx

# === OPENCLAW (Phase 5 + 9) ===
OPENCLAW_URL=https://openclaw.example.com
OPENCLAW_WEBHOOK_SECRET=xxx
CRON_SECRET=xxx

# === OPENCLAW CHAT AGENT (Phase 9) ===
OPENCLAW_CHAT_MODEL=gpt-4o
ADMIN_WHATSAPP_NUMBER=          # Operator number for escalation alerts (e.g. 6241234567)
GOOGLE_REVIEW_URL=              # Direct Google Reviews link for GAFF

# === REVIEWS (Phase 6) ===
TRIPADVISOR_REVIEWS_URL=https://example.com/tripadvisor-reviews.json
GOOGLE_REVIEWS_URL=https://example.com/google-reviews.json
YELP_REVIEWS_URL=https://example.com/yelp-reviews.json

# === ANALYTICS (Phase 8) ===
ANALYTICS_REPORT_EMAIL=admin@gaffallfishingloscabos.com
ANALYTICS_BOAT_IDLE_DAYS=3
ANALYTICS_LEAD_DROP_THRESHOLD=0.2
ANALYTICS_REVIEW_SCORE_THRESHOLD=4.5

# === TIKTOK (Phase 7) ===
TIKTOK_ACCESS_TOKEN=xxx
TIKTOK_PUBLISH_ENDPOINT=https://open.tiktokapis.com/v2/post/publish/content/init/
TIKTOK_ADVERTISER_ID=xxx

# === APP (all phases) ===
# Optional in production now: checkout falls back to the incoming request origin.
# Keep it set when you want an explicit canonical app URL across environments.
NEXT_PUBLIC_SITE_URL=https://gaffallfishingloscabos.com
NODE_ENV=development
