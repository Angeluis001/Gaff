{
  gateway: {
    mode: "local",
    port: 8080,
    bind: "lan",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    controlUi: {
      enabled: true,
      basePath: "/openclaw",
      allowedOrigins: ["https://openclaw-gateway-production-9756.up.railway.app"],
      dangerouslyDisableDeviceAuth: true,
    },
  },
  plugins: {
    entries: {
      "gaff-assistant": {
        enabled: true,
      },
    },
  },
}
